# =====================================================================
# NILAM PESUM (நிலம் பேசும்) - Environment Variables Configuration
# =====================================================================

# NASA Earthdata Authentication (Required for restricted NASA DAAC products like HLS, SMAP L4, MODIS LP DAAC)
# NASA POWER is public and does not require credentials.
# Register for free at: https://urs.earthdata.nasa.gov/
NASA_EARTHDATA_USERNAME=your_nasa_earthdata_username
NASA_EARTHDATA_PASSWORD=your_nasa_earthdata_password
NASA_EARTHDATA_TOKEN=your_optional_earthdata_bearer_token

# NASA Services Configuration
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
NASA_CMR_BASE_URL=https://cmr.earthdata.nasa.gov/search
NASA_GIBS_WMTS_URL=https://gibs.earthdata.nasa.gov/wmts/epsg3857/best

# Database Configuration
# For local development with zero external dependencies, leave empty to use SQLite:
# sqlite:///./nilam_pesum.db
# For production Supabase PostgreSQL:
# postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./nilam_pesum.db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Backend Security
SECRET_KEY=nilam_pesum_super_secret_jwt_key_2026_secure_random
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Optional LLM Integration for Voice Assistant
# Provide Gemini API key if using cloud LLM reasoning; otherwise uses deterministic agricultural knowledge engine
GEMINI_API_KEY=

